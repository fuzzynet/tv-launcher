<?xml version="1.0" encoding="utf-8"?>
<!-- After the last app row. paddingBottom is the overscan-safe margin (48dp, 96dp at 4K),
     so the chip stays fully on screen when the row's bottom sits on the panel edge. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/support_footer_gap"
    android:paddingBottom="@dimen/overscan_safe_bottom"
    android:focusable="false"
    android:descendantFocusability="afterDescendants">

    <TextView
        android:id="@+id/btnSupport"
        style="@style/TopButton"
        android:layout_gravity="center_horizontal"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:focusable="true"
        android:clickable="false"
        android:singleLine="true"
        android:ellipsize="end"
        android:maxWidth="420dp" />
</FrameLayout>
